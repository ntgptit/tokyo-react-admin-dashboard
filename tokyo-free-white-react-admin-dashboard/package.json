{
  "name": "tokyo-free-white-react-admin-dashboard",
  "version": "2.0.0",
  "title": "Tokyo Free White React Typescript Admin Dashboard",
  "description": "This free and open source admin dashboard template is built for React and it’s bootstrapped from Facebook’s create-react-app. All NPM dependencies are up to date and it contains multiple fully customized components based on the popular frontend components framework, Material-UI.",
  "author": {
    "name": "BloomUI.com",
    "url": "https://bloomui.com"
  },
  "private": false,
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.6.0",
    "@mui/lab": "9.0.0-beta.11",
    "@mui/material": "^9.6.0",
    "@mui/x-date-pickers": "^9.18.0",
    "@tailwindcss/vite": "^4.3.5",
    "apexcharts": "^8.9.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.80.0",
    "nprogress": "^0.2.0",
    "numeral": "^2.0.6",
    "prop-types": "^15.8.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-apexcharts": "^2.2.1",
    "react-custom-scrollbars-2": "4.5.0",
    "react-dom": "^19.3.1",
    "react-helmet-async": "^3.2.0",
    "react-router": "^8.5.3",
    "tailwind-merge": "^3.7.1",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0"
  },
  "scripts": {
    "start": "vite",
    "build": "tsc --noEmit && vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"./**/*.{ts,tsx,js,jsx,json}\" --config ./.prettierrc",
    "dev": "vite",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.11",
    "@types/nprogress": "^0.2.3",
    "@types/numeral": "^2.0.5",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8"
  },
  "pnpm": {
    "peerDependencyRules": {
      "allowedVersions": {
        "react-custom-scrollbars-2>react": "19",
        "react-custom-scrollbars-2>react-dom": "19"
      }
    }
  },
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20.19"
  },
  "type": "module"
}
